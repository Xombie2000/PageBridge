{
  "manifest_version": 3,
  "name": "PageBridge",
  "version": "1.0.7",
  "description": "Privately translate Japanese webpage text to English on this Mac.",
  "icons": {
    "16": "icons/pagebridge-16.png",
    "32": "icons/pagebridge-32.png",
    "48": "icons/pagebridge-48.png",
    "64": "icons/pagebridge-64.png",
    "128": "icons/pagebridge-128.png"
  },
  "permissions": ["activeTab", "nativeMessaging", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["shared.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "action": {
    "default_title": "PageBridge",
    "default_icon": {
      "16": "icons/pagebridge-16.png",
      "32": "icons/pagebridge-32.png",
      "48": "icons/pagebridge-48.png",
      "64": "icons/pagebridge-64.png"
    },
    "default_popup": "popup.html"
  }
}
